---
import { HeaderWrapper } from '@/components/header/wrapper';
import db, { places } from '@/db';
import Layout from '@/layouts/base.astro';

export const prerender = false;

const regionsResult = await db.selectDistinct({ region: places.region }).from(places).orderBy(places.region);
const regions = regionsResult.map((r) => r.region);
---

<Layout
  title="PLACES — населеныя пункты Беларусі"
  description="Просты пошукавік населеных пунктаў Беларусі. База складаецца амаль з 24 000 населеных пунктаў, змяшчае націскі і ўжываныя альтэрнатыўныя назвы."
>
  <main class="min-h-screen">
    <HeaderWrapper variant="centered" regions={regions} client:load />
  </main>
</Layout>
