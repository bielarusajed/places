---
import Layout from '@/layouts/base.astro';
import LoginForm from '@/pages/login/_form';

export const prerender = false;

if (Astro.locals.user) return Astro.redirect('/admin');
---

<Layout title="Уваход — PLACES">
  <main class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4">
    <LoginForm client:load />
  </main>
</Layout>
