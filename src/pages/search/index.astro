---
import Header from '@/components/header';
import db, { places } from '@/db';
import Layout from '@/layouts/base.astro';

import SearchResults from './_search-results';

export const prerender = false;

const url = new URL(Astro.request.url);
const initialQuery = url.searchParams.get('q') || '';

const regionsResult = await db.selectDistinct({ region: places.region }).from(places).orderBy(places.region);
const regions = regionsResult.map((r) => r.region);
---

<Layout title={initialQuery ? `Пошук: ${initialQuery}` : 'Пошук'}>
  <div>
    <Header variant="search" regions={regions} client:load />
    <main class="container mx-auto px-4 py-6" transition:animate="slide">
      <SearchResults client:load />
    </main>
  </div>
</Layout>
