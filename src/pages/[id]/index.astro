---
import { eq } from 'drizzle-orm';

import { HeaderWrapper } from '@/components/header/wrapper';
import ParadigmCarousel from '@/components/paradigm-carousel';
import PlaceMap from '@/components/place-map.astro';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import db, { forms, places } from '@/db';
import Layout from '@/layouts/base.astro';
import { localityTypeLabels, type PlaceForm } from '@/lib/types';

export const prerender = false;

const { id } = Astro.params;
const placeId = Number(id);

if (isNaN(placeId)) return Astro.redirect('/');

const [placeResult, regionsResult] = await Promise.all([
  db.select().from(places).where(eq(places.id, placeId)).limit(1),
  db.selectDistinct({ region: places.region }).from(places).orderBy(places.region),
]);

if (placeResult.length === 0) return Astro.redirect('/');

const regions = regionsResult.map((r) => r.region);

const placeForms = (await db
  .select({
    id: forms.id,
    type: forms.type,
    form: forms.form,
    gender: forms.gender,
    stressIndexes: forms.stressIndexes,
    paradigmVariant: forms.paradigmVariant,
    paradigmTag: forms.paradigmTag,
  })
  .from(forms)
  .where(eq(forms.placeId, placeId))) as PlaceForm[];

const place = {
  ...placeResult[0],
  forms: placeForms,
};

const mainForm = placeForms.find((f) => f.type === 'main');
const aliasNames = placeForms.filter((f) => f.type === 'alias' || f.type === 'alias-ru');
const transliteration = placeForms.find((f) => f.type === 'transliteration');
const russian = placeForms.find((f) => f.type === 'russian');
const paradigmForms = placeForms.filter((f) => f.type === 'paradigm');

const title = mainForm?.form ?? place.name;

const hasTranslations = transliteration || russian;
const hasAliases = aliasNames.length > 0;
const hasGrammar = mainForm?.gender;
const hasParadigms = paradigmForms.length > 0;
const hasCoordinates = place.coordinates !== null;

const genderLabels = {
  m: 'мужчынскі род',
  f: 'жаночы род',
  n: 'ніякі род',
  p: 'множны лік',
} as const;

const genderShort = {
  m: 'м.',
  f: 'ж.',
  n: 'н.',
  p: 'мн.',
} as const;

const locationParts = [
  `${place.region} вобласць`,
  place.district ? `${place.district} раён` : null,
  place.council ? `${place.council} сельсавет` : null,
].filter((v) => !!v);
---

<Layout
  title={`${title} — PLACES`}
  ogImage={`${Astro.url.origin}/og/${id}.png`}
  description={locationParts.join(' • ')}
>
  <HeaderWrapper variant="top" regions={regions} client:load />
  <main class="mx-auto max-w-lg px-4 py-10" transition:animate="slide">
    <header class="mb-10 text-center">
      <Badge variant="secondary" className="mb-4">
        {localityTypeLabels[place.type]}
      </Badge>
      <h1 class="mb-3 text-5xl font-bold tracking-tight">{place.name}</h1>
      <p class="text-muted-foreground text-sm">{locationParts.join(' • ')}</p>
    </header>

    <Separator className="my-8" />

    <div class="space-y-8">
      {
        hasTranslations && (
          <section>
            <h2 class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase">Назвы</h2>
            {transliteration && (
              <div class="flex items-center justify-between gap-4 border-b py-3">
                <span class="text-muted-foreground">Лацінкай</span>
                <span class="font-medium">{transliteration.form}</span>
              </div>
            )}
            {russian && (
              <div class="flex items-center justify-between gap-4 py-3">
                <span class="text-muted-foreground">Па-руску</span>
                <span class="font-medium">{russian.form}</span>
              </div>
            )}
          </section>
        )
      }

      {
        hasAliases && (
          <section>
            <h2 class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase">Іншыя назвы</h2>
            <div class="flex flex-wrap gap-2">
              {aliasNames.map((alias) => (
                <Badge variant={alias.type === 'alias-ru' ? 'outline' : 'secondary'}>
                  {alias.form}
                  {alias.gender && <span class="text-muted-foreground">({genderShort[alias.gender]})</span>}
                  {alias.type === 'alias-ru' && <span class="opacity-50">рус.</span>}
                </Badge>
              ))}
            </div>
          </section>
        )
      }

      {
        (hasGrammar || hasParadigms) && (
          <section>
            <h2 class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase">Граматыка</h2>
            {hasGrammar && mainForm.gender && (
              <div class="flex items-center justify-between gap-4 py-3">
                <span class="text-muted-foreground">Род</span>
                <span class="font-medium">{genderLabels[mainForm.gender]}</span>
              </div>
            )}
            {hasParadigms && (
              <div class={hasGrammar ? 'mt-4' : ''}>
                <ParadigmCarousel paradigmForms={paradigmForms} mainFormText={mainForm?.form ?? ''} client:load />
              </div>
            )}
          </section>
        )
      }

      {
        hasCoordinates && place.coordinates && (
          <section>
            <h2 class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase">На мапе</h2>
            <PlaceMap lat={place.coordinates.lat} lng={place.coordinates.lng} name={place.name} osmId={place.osmId} />
          </section>
        )
      }
    </div>
  </main>
</Layout>
